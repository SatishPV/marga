# Copy this to .env and adjust if needed:
#   cp .env.example .env
#
# .env is gitignored — never commit real credentials, even local dev
# ones. These defaults match what docker-compose.yml expects and are
# used to set up the Postgres/MongoDB containers AND to tell the marga
# app container how to connect to them.

POSTGRES_USER=marga
POSTGRES_PASSWORD=marga
POSTGRES_DB=marga_demo

MONGO_USER=marga
MONGO_PASSWORD=marga
MONGO_DB=marga_demo

# Elasticsearch has security disabled in this local dev setup
# (docker-compose.yml sets xpack.security.enabled=false) — no
# credentials needed for it here.

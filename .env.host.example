# For running `marga` CLI/pytest directly on your machine (NOT inside
# Docker) against the docker-compose services. Different from .env:
# the container reaches Postgres/Mongo/ES by service name on the
# internal Docker network; your host machine reaches them via
# localhost and the mapped ports in docker-compose.yml.
#
# Usage:
#   cp .env.host.example .env.host
#   set -a && source .env.host && set +a
#   marga scan postgres://public.customers
#
# .env.host is gitignored, same as .env — do not commit real credentials.

MARGA_POSTGRES_HOST=localhost
MARGA_POSTGRES_PORT=5433
MARGA_POSTGRES_DBNAME=marga_demo
MARGA_POSTGRES_USER=marga
MARGA_POSTGRES_PASSWORD=marga

MARGA_MONGODB_HOST=localhost
MARGA_MONGODB_PORT=27017
MARGA_MONGODB_USER=marga
MARGA_MONGODB_PASSWORD=marga
MARGA_MONGODB_DBNAME=marga_demo

MARGA_ELASTICSEARCH_HOST=http://localhost:9200
